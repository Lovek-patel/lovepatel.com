---
import Tag from './Tag.astro';
const { project } = Astro.props;
---
<article class="card flex flex-col gap-4">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-starlight/60">{project.category}</p>
      <h3 class="mt-2 text-xl font-semibold text-starlight">{project.title}</h3>
      <p class="mt-2 text-sm text-starlight/70">{project.summary}</p>
    </div>
  </div>
  <div class="flex flex-wrap gap-2">
    {project.tags.map((tag) => (
      <Tag label={tag} />
    ))}
  </div>
  <a href={`/projects/${project.slug}`} class="mt-auto text-sm font-semibold text-aurora">View details →</a>
</article>
