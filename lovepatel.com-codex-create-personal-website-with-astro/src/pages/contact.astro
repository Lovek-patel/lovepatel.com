---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact | Love Patel"
  description="Connect with Love Patel for collaborations and conversations."
>
  <style>
    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem;
    }

    .heading {
      font-size: 2.8rem;
      color: #d4af37;
      text-align: center;
      margin-bottom: 0.5rem;
      font-weight: 600;
      border-bottom: 1px solid #ccc;
      padding-bottom: 0.7rem;
    }

    .intro {
      font-size: 1.15rem;
      color: #ccc;
      text-align: center;
      margin-bottom: 2rem;
    }

    .contact-grid {
      display: grid;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .contact-grid.row-1 {
      grid-template-columns: repeat(3, 1fr);
    }

    .contact-grid.row-2 {
      grid-template-columns: repeat(2, 1fr);
      justify-content: center;
    }

    .flip-card {
      perspective: 1000px;
    }

    .flip-inner {
      position: relative;
      width: 100%;
      height: 180px;
      text-align: center;
      transition: transform 0.6s;
      transform-style: preserve-3d;
    }

    .flip-card:hover .flip-inner {
      transform: rotateY(180deg);
    }

    .flip-front,
    .flip-back {
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      backface-visibility: hidden;
      box-shadow: 0 0 12px rgba(0, 0, 0, 0.3);
    }

    .flip-front {
      background-color: #1c1c1c;
      padding: 10px;
    }

    .flip-front img {
      max-height: 80px;
      width: auto;
    }

    .flip-back {
      background-color: #3d5afe;
      color: #fff;
      transform: rotateY(180deg);
      padding: 0 10px;
    }

    .flip-back a {
      color: #fff;
      font-size: 1.05rem;
      text-decoration: none;
    }

    .flip-back a:hover {
      text-decoration: underline;
    }

    .quote {
      max-width: 600px;
      margin: 3rem auto 0 auto;
      font-size: 1.2rem;
      color: #888;
      font-style: italic;
      text-align: center;
      border-top: 1px solid #ccc;
      padding-top: 1.5rem;
    }

    .quote span {
      display: block;
      font-size: 0.95rem;
      margin-top: 0.5rem;
      color: #666;
    }
  </style>

  <main class="container" id="main-content">
    <div class="heading">Get in Touch</div>
    <div class="intro">Whether it’s for collaboration, conversation, or just to say hello — I’d love to hear from you.</div>

    <div class="contact-grid row-1">
      <div class="flip-card">
        <div class="flip-inner">
          <div class="flip-front"><img src="/email.png" alt="Email Logo" /></div>
          <div class="flip-back"><a href="mailto:lkp2133@columbia.edu">lkp2133@columbia.edu</a></div>
        </div>
      </div>
      <div class="flip-card">
        <div class="flip-inner">
          <div class="flip-front"><img src="/website.png" alt="Website Logo" /></div>
          <div class="flip-back"><a href="https://lovepatel.com" target="_blank" rel="noreferrer">lovepatel.com</a></div>
        </div>
      </div>
      <div class="flip-card">
        <div class="flip-inner">
          <div class="flip-front"><img src="/linkedin.png" alt="LinkedIn Logo" /></div>
          <div class="flip-back"><a href="https://www.linkedin.com/in/lovekpatel" target="_blank" rel="noreferrer">@lovekpatel</a></div>
        </div>
      </div>
    </div>

    <div class="contact-grid row-2">
      <div class="flip-card">
        <div class="flip-inner">
          <div class="flip-front"><img src="/instagram.png" alt="Instagram Logo" /></div>
          <div class="flip-back"><a href="https://www.instagram.com/lovek.patel" target="_blank" rel="noreferrer">@lovek.patel</a></div>
        </div>
      </div>
      <div class="flip-card">
        <div class="flip-inner">
          <div class="flip-front"><img src="/snapchat.png" alt="Snapchat Logo" /></div>
          <div class="flip-back"><a href="https://www.snapchat.com/add/lovek.patel" target="_blank" rel="noreferrer">@lovek.patel</a></div>
        </div>
      </div>
    </div>

    <div class="quote">
      “Reaching out takes nothing more than a smile.”
      <span>– Ron Kaufman</span>
    </div>
  </main>
</BaseLayout>
