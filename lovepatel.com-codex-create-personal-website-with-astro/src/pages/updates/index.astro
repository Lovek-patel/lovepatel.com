---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const updates = await getCollection('updates');
const sorted = updates.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Life Updates" description="Life updates, essays, and reflections.">
  <Header slot="header" />
  <section class="mx-auto max-w-4xl px-6 py-16">
    <p class="pill">Life Updates</p>
    <h1 class="mt-6 font-serif text-4xl font-semibold">Signals & Notes</h1>
    <p class="mt-4 text-lg text-starlight/70">
      A stream of life updates, reflections, and progress notes from the lab, the studio, and beyond.
    </p>

    <div class="mt-10 space-y-6">
      {sorted.map((post) => (
        <article class="card">
          <p class="text-xs uppercase tracking-[0.3em] text-starlight/60">{post.data.date.toLocaleDateString()}</p>
          <h2 class="mt-3 text-2xl font-semibold text-starlight">{post.data.title}</h2>
          <p class="mt-2 text-sm text-starlight/70">{post.data.description}</p>
          <a class="mt-4 inline-block text-sm font-semibold text-aurora" href={`/updates/${post.slug}`}>Read update →</a>
        </article>
      ))}
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>
