---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Carousel from '../components/Carousel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featuredProjects = projects.slice(0, 4).map((entry) => ({
  ...entry.data,
  slug: entry.slug
}));

const carouselItems = [
  {
    label: 'Featured Update',
    title: 'Ad Astra: A North Star for 2025',
    description: 'Setting an intentional direction for the year with focus on craft, research, and impact.'
  },
  {
    label: 'Featured Project',
    title: 'ASCEND',
    description: 'A modular AI architecture for decision-making, memory, and long-horizon planning.'
  },
  {
    label: 'Featured Project',
    title: 'Primis',
    description: 'A vision for a global education system rooted in ethics and curiosity.'
  }
];
---
<BaseLayout title="Home" description="Love Patel — space-inspired personal website, projects, and life updates.">
  <Header slot="header" />
  <section class="mx-auto flex max-w-6xl flex-col gap-12 px-6 py-16">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <p class="pill">Ad Astra</p>
        <h1 class="mt-6 font-serif text-4xl font-semibold text-starlight md:text-5xl">Designing systems that make the impossible feel inevitable.</h1>
        <p class="mt-6 text-lg text-starlight/70">
          Welcome to my personal constellation — a curated space for experiments, life updates, and the projects shaping my future.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a class="rounded-full border border-white/10 bg-aurora px-6 py-3 text-sm font-semibold text-cosmic-900" href="/projects">Explore Projects</a>
          <a class="rounded-full border border-white/10 px-6 py-3 text-sm font-semibold text-starlight/80" href="/updates">Read Life Updates</a>
        </div>
      </div>
      <div class="card">
        <p class="text-xs uppercase tracking-[0.3em] text-starlight/60">Latest Update</p>
        <h2 class="mt-4 text-2xl font-semibold text-starlight">Quiet Progress, Real Momentum</h2>
        <p class="mt-3 text-sm text-starlight/70">Shipping isn't always loud. Here's what quietly moved forward this month.</p>
        <a class="mt-6 text-sm font-semibold text-aurora" href="/updates/2025-03-30-quiet-progress">Read more →</a>
      </div>
    </div>

    <div class="grid gap-6">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-starlight">Featured Projects</h2>
        <a class="text-sm font-semibold text-aurora" href="/projects">View all →</a>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>

    <div class="grid gap-6">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-starlight">Featured Feed</h2>
        <p class="text-sm text-starlight/60">Use arrows or swipe to navigate.</p>
      </div>
      <Carousel items={carouselItems} />
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>
