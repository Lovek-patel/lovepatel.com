---
const { items } = Astro.props;
---
<div class="relative" data-carousel tabindex="0">
  <div class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory" data-carousel-track>
    {items.map((item) => (
      <article class="card min-w-[280px] flex-1 snap-center">
        <p class="text-xs uppercase tracking-[0.3em] text-starlight/60">{item.label}</p>
        <h3 class="mt-3 text-lg font-semibold text-starlight">{item.title}</h3>
        <p class="mt-2 text-sm text-starlight/70">{item.description}</p>
        {item.href ? (
          <a class="mt-4 inline-flex text-sm font-semibold text-aurora" href={item.href}>
            {item.linkLabel ?? 'Read more →'}
          </a>
        ) : null}
      </article>
    ))}
  </div>
  <div class="mt-4 flex items-center gap-3">
    <button class="h-9 w-9 rounded-full border border-white/10 bg-cosmic-800 text-starlight/80" data-carousel-prev aria-label="Previous slide">‹</button>
    <button class="h-9 w-9 rounded-full border border-white/10 bg-cosmic-800 text-starlight/80" data-carousel-next aria-label="Next slide">›</button>
  </div>
</div>

<script is:inline>
  const carousels = document.querySelectorAll('[data-carousel]');
  carousels.forEach((carousel) => {
    const track = carousel.querySelector('[data-carousel-track]');
    const prev = carousel.querySelector('[data-carousel-prev]');
    const next = carousel.querySelector('[data-carousel-next]');
    if (!track || !prev || !next) return;

    const slides = Array.from(track.children);
    if (slides.length === 0) return;
    let index = 0;

    const update = () => {
      const offset = slides[0].offsetWidth + 24;
      track.scrollTo({ left: offset * index, behavior: 'smooth' });
    };

    prev.addEventListener('click', () => {
      index = (index - 1 + slides.length) % slides.length;
      update();
    });

    next.addEventListener('click', () => {
      index = (index + 1) % slides.length;
      update();
    });

    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        index = (index - 1 + slides.length) % slides.length;
        update();
      }
      if (event.key === 'ArrowRight') {
        index = (index + 1) % slides.length;
        update();
      }
    });

    let startX = 0;
    track.addEventListener('touchstart', (event) => {
      startX = event.touches[0].clientX;
    });

    track.addEventListener('touchend', (event) => {
      const delta = event.changedTouches[0].clientX - startX;
      if (Math.abs(delta) < 40) return;
      if (delta > 0) {
        index = (index - 1 + slides.length) % slides.length;
      } else {
        index = (index + 1) % slides.length;
      }
      update();
    });
  });
</script>
