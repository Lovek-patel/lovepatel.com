---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/updates', label: 'Life Updates' },
  { href: '/resume', label: 'Resume' },
  { href: '/contact', label: 'Contact' }
];
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-cosmic-900/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-3 text-sm font-semibold tracking-[0.3em] uppercase">
      <img src="/Logo.png" alt="Love Patel" class="h-9 w-9 rounded-xl border border-white/10 bg-cosmic-800" />
      <span class="hidden text-starlight sm:inline">Love Patel</span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      {navItems.map((item) => (
        <a class="nav-link" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <button
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-cosmic-800 text-starlight/80 transition hover:text-starlight"
        data-theme-toggle
        aria-label="Toggle theme"
        aria-pressed="false"
      >
        <span class="text-xs tracking-[0.2em]">◐</span>
      </button>
      <a
        href="/updates"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-cosmic-800 text-starlight/80 transition hover:text-starlight"
        aria-label="Life updates"
      >
        <span class="text-xs tracking-[0.2em]">RSS</span>
      </a>
      <button
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-cosmic-800 text-starlight/80 transition hover:text-starlight lg:hidden"
        data-mobile-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-panel"
      >
        <span class="text-xl">⋮</span>
      </button>
    </div>
  </div>

  <div class="lg:hidden" data-mobile-overlay>
    <div class="fixed inset-0 bg-cosmic-900/60 opacity-0 pointer-events-none transition-opacity duration-300" data-overlay></div>
    <aside
      id="mobile-panel"
      class="fixed right-0 top-0 h-full w-72 translate-x-full border-l border-white/10 bg-cosmic-900/95 p-6 transition-transform duration-300"
      data-panel
    >
      <div class="flex items-center justify-between">
        <span class="text-xs uppercase tracking-[0.3em] text-starlight/60">Navigate</span>
        <button
          type="button"
          class="flex h-8 w-8 items-center justify-center rounded-full border border-white/10 bg-cosmic-800 text-starlight/80"
          data-mobile-close
          aria-label="Close menu"
        >
          ✕
        </button>
      </div>
      <nav class="mt-8 flex flex-col gap-4" aria-label="Mobile">
        {navItems.map((item) => (
          <a class="text-lg text-starlight/80 hover:text-starlight" href={item.href}>{item.label}</a>
        ))}
      </nav>
    </aside>
  </div>
</header>
