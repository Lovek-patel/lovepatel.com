---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/updates', label: 'Life Updates' },
  { href: '/resume', label: 'Resume' },
  { href: '/contact', label: 'Contact' }
];
---
<header class="site-header">
  <div class="header-inner">
    <a class="logo-link" href="/" aria-label="Love Patel home">
      <img src="/Logo.png" alt="Love Patel logo" loading="eager" />
      <span>Love Patel</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="control-cluster" aria-label="Utility controls">
      <button class="icon-button" type="button" data-theme-toggle aria-pressed="false" aria-label="Toggle theme">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 4a1 1 0 0 1 1 1v1.2a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1Zm0 12.8a1 1 0 0 1 1 1V19a1 1 0 1 1-2 0v-1.2a1 1 0 0 1 1-1Zm7-5.8a1 1 0 0 1 1 1v.2a1 1 0 1 1-2 0v-.2a1 1 0 0 1 1-1Zm-12 0a1 1 0 0 1 1 1v.2a1 1 0 1 1-2 0v-.2a1 1 0 0 1 1-1Zm9.66-5.66a1 1 0 0 1 1.41 0l.85.85a1 1 0 1 1-1.42 1.42l-.84-.85a1 1 0 0 1 0-1.42Zm-9.18 9.18a1 1 0 0 1 1.41 0l.85.85a1 1 0 1 1-1.42 1.42l-.84-.85a1 1 0 0 1 0-1.42Zm9.18 1.42a1 1 0 0 1 0 1.41l-.85.85a1 1 0 1 1-1.42-1.42l.85-.84a1 1 0 0 1 1.42 0Zm-9.18-9.18a1 1 0 0 1 0 1.42l-.85.84a1 1 0 1 1-1.42-1.42l.85-.85a1 1 0 0 1 1.42 0ZM12 8.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7Z" fill="currentColor" />
        </svg>
        <span class="sr-only">Toggle theme</span>
      </button>
      <button class="icon-button" type="button" data-search-toggle aria-haspopup="dialog" aria-controls="searchDialog" aria-label="Open search">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M11 4a7 7 0 1 1 0 14 7 7 0 0 1 0-14Zm0 2a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm8.71 12.29a1 1 0 0 1 0 1.42 1 1 0 0 1-1.42 0l-3.2-3.2a1 1 0 1 1 1.42-1.42l3.2 3.2Z" fill="currentColor" />
        </svg>
        <span class="sr-only">Open search</span>
      </button>
      <a class="icon-button" href="/updates" aria-label="Life updates">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M6.5 17a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm-2-6.5a1 1 0 0 1 1-1 9 9 0 0 1 9 9 1 1 0 1 1-2 0 7 7 0 0 0-7-7 1 1 0 0 1-1-1Zm0-5a1 1 0 0 1 1-1c7.18 0 13 5.82 13 13a1 1 0 1 1-2 0c0-6.08-4.92-11-11-11a1 1 0 0 1-1-1Z" fill="currentColor" />
        </svg>
        <span class="sr-only">Life updates</span>
      </a>
      <button class="mobile-toggle" type="button" data-mobile-toggle aria-expanded="false" aria-controls="mobilePanel" aria-label="Open menu">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-overlay" data-mobile-overlay></div>

<aside class="mobile-panel" id="mobilePanel" data-mobile-panel>
  <div class="mobile-panel-header">
    <span>Navigate</span>
    <button class="icon-button" type="button" data-mobile-close aria-label="Close menu">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6.7 5.3a1 1 0 0 1 1.4 0L12 9.18l3.9-3.88a1 1 0 1 1 1.4 1.42L13.42 10.6l3.88 3.9a1 1 0 0 1-1.42 1.4L12 12l-3.9 3.9a1 1 0 0 1-1.4-1.42l3.88-3.88-3.88-3.9a1 1 0 0 1 0-1.42Z" fill="currentColor" />
      </svg>
      <span class="sr-only">Close menu</span>
    </button>
  </div>
  <nav aria-label="Mobile">
    {navLinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
</aside>

<dialog class="search-dialog" id="searchDialog" data-search-dialog>
  <div class="search-content">
    <div>
      <strong>Quick Search</strong>
      <p>Search is coming soon. For now, jump directly to a page.</p>
    </div>
    <input type="text" placeholder="Search the site" aria-label="Search the site" />
    <div class="search-actions">
      <span>Tip: Use the navigation links to explore.</span>
      <button class="icon-button" type="button" data-search-close>Close</button>
    </div>
  </div>
</dialog>
