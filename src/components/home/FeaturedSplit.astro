---
import ProjectCard from '../ProjectCard.astro';
import UpdateCard from '../UpdateCard.astro';

const { project, update } = Astro.props;
---
<section class="grid gap-6">
  <div>
    <p class="text-xs uppercase tracking-[0.3em] text-starlight/60">Featured Focus</p>
    <h2 class="mt-3 text-2xl font-semibold text-starlight">Featured Focus</h2>
    <p class="mt-2 text-sm text-starlight/70">
      A spotlight on what is shaping the roadmap right now.
    </p>
  </div>
  <div class="grid gap-6 lg:grid-cols-2">
    <ProjectCard project={project} />
    <UpdateCard update={update} />
  </div>
</section>
