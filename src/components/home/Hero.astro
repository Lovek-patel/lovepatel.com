---
import AboutSummary from './AboutSummary.astro';
import ContactBar from './ContactBar.astro';

const { pill, headline, summary, actions, image } = Astro.props;
const imageSrc = image?.src;
const imageAlt = image?.alt ?? 'Portrait placeholder';
---
<div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
  <div>
    <p class="pill">{pill}</p>
    <h1 class="mt-6 font-serif text-4xl font-semibold text-starlight md:text-5xl">
      {headline}
    </h1>
    <AboutSummary text={summary} />
    <ContactBar actions={actions} />
  </div>
  <div class="relative">
    {imageSrc ? (
      <img
        src={imageSrc}
        alt={imageAlt}
        class="h-full min-h-[320px] w-full rounded-3xl border border-white/10 object-cover shadow-lg shadow-cosmic-950/40"
        loading="lazy"
      />
    ) : (
      <div class="flex min-h-[320px] items-center justify-center rounded-3xl border border-white/10 bg-gradient-to-br from-cosmic-800 via-cosmic-900 to-cosmic-950 px-6 text-center text-sm text-starlight/70">
        <span>Portrait coming soon</span>
      </div>
    )}
  </div>
</div>
