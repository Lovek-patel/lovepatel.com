---
import ProjectCard from '../ProjectCard.astro';

const { heading, linkHref, linkLabel, projects } = Astro.props;
---
<div class="grid gap-6">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-semibold text-starlight">{heading}</h2>
    <a class="text-sm font-semibold text-aurora" href={linkHref}>
      {linkLabel}
    </a>
  </div>
  <div class="flex gap-6 overflow-x-auto scroll-smooth pb-2 snap-x snap-mandatory">
    {projects.map((project) => (
      <div class="min-w-[260px] flex-1 snap-start md:min-w-[320px] lg:min-w-[360px]">
        <ProjectCard project={project} />
      </div>
    ))}
  </div>
</div>
