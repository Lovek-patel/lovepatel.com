---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const resolveProjectSlug = (entry) => entry.slug ?? entry.id.replace(/\.json$/, '');
const mapped = projects.map((entry) => ({
  ...entry.data,
  slug: resolveProjectSlug(entry)
}));
---
<BaseLayout title="Projects" description="Explore Love Patel's project portfolio.">
  <Header slot="header" />
  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col gap-4">
      <p class="pill">Portfolio</p>
      <h1 class="font-serif text-4xl font-semibold">Projects</h1>
      <p class="text-lg text-starlight/70">
        A gallery of research, systems, and creative experiments. Each project is a step toward a more thoughtful future.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {mapped.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>
