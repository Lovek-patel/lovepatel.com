---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="About" description="About Love Patel — bio, values, and interests.">
  <Header slot="header" />
  <section class="mx-auto max-w-4xl px-6 py-16">
    <p class="pill">Biography</p>
    <h1 class="mt-6 font-serif text-4xl font-semibold">About Me</h1>
    <p class="mt-6 text-lg text-starlight/70">
      I’m Love Patel — a builder focused on biomedical engineering, thoughtful systems, and creative futures. I care about the
      intersection of science, ethics, and design.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="card">
        <h2 class="text-xl font-semibold">Values</h2>
        <ul class="mt-4 space-y-2 text-sm text-starlight/70">
          <li>• Curiosity with rigor.</li>
          <li>• Empathy as a design constraint.</li>
          <li>• Long-horizon impact over short-term noise.</li>
        </ul>
      </div>
      <div class="card">
        <h2 class="text-xl font-semibold">Interests</h2>
        <ul class="mt-4 space-y-2 text-sm text-starlight/70">
          <li>• Human-centered AI systems.</li>
          <li>• Bioenergy and therapeutic materials.</li>
          <li>• Writing that blends philosophy and science.</li>
        </ul>
      </div>
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>
