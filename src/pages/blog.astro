---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Blog | Love Patel"
  description="Read Love Patel's reflections, essays, and life updates."
>
  <style>
    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem;
    }

    .blog-box {
      background: #1b1b1b;
      padding: 2rem;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0,0,0,0.5);
    }

    .blog-box h2 {
      font-family: 'Playfair Display', serif;
      color: #c79c3b;
      margin-top: 0;
      font-size: 2rem;
    }

    .post-preview {
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #333;
      transition: all 0.3s ease;
    }

    .post-preview:hover {
      background-color: #1e1e1e;
      border-left: 3px solid #c79c3b;
      padding-left: 1rem;
    }

    .post-preview h3 {
      margin-bottom: 0.5rem;
      font-size: 1.4rem;
      color: #f0f0f0;
    }

    .post-preview p {
      color: #bbb;
      line-height: 1.6;
    }
  </style>

  <main class="container" id="main-content">
    <div class="blog-box">
      <h2>📰 Blog</h2>

      <div class="post-preview">
        <h3><a href="/blog-post-1">🎭 Blog Post 1</a></h3>
        <p>Exploring the intersection of identity, ambition, and emotion through art and storytelling.</p>
      </div>

      <div class="post-preview">
        <h3>📚 Blog Post 2</h3>
        <p>What it means to build a personal philosophy — lessons from Plato, Rumi, and modern life.</p>
      </div>

      <div class="post-preview">
        <h3>🧠 Blog Post 3</h3>
        <p>Thoughts on education, failure, and the invisible curriculum we all live through.</p>
      </div>
    </div>
  </main>
</BaseLayout>
