---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Contact" description="Contact Love Patel for collaborations and conversation.">
  <Header slot="header" />
  <section class="mx-auto max-w-4xl px-6 py-16">
    <p class="pill">Contact</p>
    <h1 class="mt-6 font-serif text-4xl font-semibold">Let’s Connect</h1>
    <p class="mt-4 text-lg text-starlight/70">
      Reach out for collaborations, research, or thoughtful conversation.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="card">
        <h2 class="text-xl font-semibold">Email</h2>
        <p class="mt-2 text-sm text-starlight/70">lkp2133@columbia.edu</p>
        <a class="mt-4 inline-block text-sm font-semibold text-aurora" href="mailto:lkp2133@columbia.edu">Send an email →</a>
      </div>
      <div class="card">
        <h2 class="text-xl font-semibold">Social</h2>
        <ul class="mt-4 space-y-2 text-sm text-starlight/70">
          <li><a class="hover:text-starlight" href="https://www.linkedin.com/in/lovekpatel" target="_blank" rel="noreferrer">LinkedIn</a></li>
          <li><a class="hover:text-starlight" href="https://www.instagram.com/lovek.patel" target="_blank" rel="noreferrer">Instagram</a></li>
          <li><a class="hover:text-starlight" href="https://lovepatel.com" target="_blank" rel="noreferrer">Website</a></li>
        </ul>
      </div>
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>
