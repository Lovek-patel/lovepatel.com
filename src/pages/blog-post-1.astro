---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Blog Post 1 | Love Patel"
  description="Blog Post 1 by Love Patel."
>
  <style>
    .blog-post {
      max-width: 800px;
      margin: auto;
      padding: 2rem;
      line-height: 1.8;
    }

    h1 {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    .date {
      color: #888;
      font-size: 0.9rem;
      margin-bottom: 2rem;
    }

    .back-link {
      display: inline-block;
      margin-bottom: 1.5rem;
      color: var(--color-muted);
    }
  </style>

  <main class="blog-post" id="main-content">
    <a class="back-link" href="/blog">← Back to Blog</a>
    <h1>Blog Post 1</h1>
    <div class="date">June 2025</div>

    <p>
      This is the placeholder text for Blog Post 1. You can replace this with your actual writing.
      Just edit the file in GitHub, update the title, date, and content here — and commit.
    </p>

    <p>
      The formatting is mobile-friendly, easy to read, and keeps focus on your writing.
    </p>
  </main>
</BaseLayout>
