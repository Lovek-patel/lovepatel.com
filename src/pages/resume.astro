---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Resume | Love Patel"
  description="Download Love Patel's resume and review highlights."
>
  <style>
    .resume-card {
      background: #1a1a1a;
      border-radius: 16px;
      padding: 2.5rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    .resume-card h1 {
      margin-top: 0;
      font-family: 'Playfair Display', serif;
      color: #d4af37;
    }

    .resume-card p {
      color: #c9c9c9;
      line-height: 1.7;
    }

    .resume-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 2rem;
    }

    .resume-button {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.85rem 1.5rem;
      border-radius: 10px;
      border: 1px solid #333;
      background: #1c1c1c;
      color: #f5f5f5;
      text-decoration: none;
      font-weight: 600;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .resume-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(199, 156, 59, 0.3);
    }

    .resume-highlights {
      margin-top: 2rem;
      display: grid;
      gap: 1rem;
    }

    .highlight {
      padding: 1rem 1.5rem;
      border-radius: 12px;
      background: #141414;
      border: 1px solid #333;
    }
  </style>

  <main id="main-content">
    <div class="resume-card">
      <h1>Resume</h1>
      <p>
        Download the latest version of my resume for an overview of my education, experience, and current focus.
      </p>
      <div class="resume-actions">
        <a class="resume-button" href="/resume.pdf" download>
          ⬇️ Download Resume PDF
        </a>
        <a class="resume-button" href="/contact">
          📬 Contact Me
        </a>
      </div>

      <div class="resume-highlights">
        <div class="highlight">
          <strong>Focus Areas:</strong> Biomedical engineering, human-centered systems, and interdisciplinary research.
        </div>
        <div class="highlight">
          <strong>Recent Work:</strong> Research in chemistry, AI systems, and educational design initiatives.
        </div>
        <div class="highlight">
          <strong>Collaboration:</strong> Open to research, writing, and product collaboration opportunities.
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
