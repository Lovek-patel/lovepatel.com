---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Projects | Love Patel"
  description="Explore Love Patel's projects in engineering, chemistry, philosophy, and writing."
>
  <style>
    :global(body) {
      margin: 0;
      font-family: 'Playfair Display', serif;
      background: black;
      color: white;
      overflow-x: hidden;
    }

    .hero-section {
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 2rem;
      text-align: center;
    }

    .hero-title {
      font-size: 4rem;
      color: #d4af37;
      margin-bottom: 1rem;
    }

    .hero-description {
      font-size: 1.3rem;
      color: #ccc;
      max-width: 800px;
    }

    .quote {
      margin-top: 2rem;
      font-style: italic;
      font-size: 1.1rem;
      color: #888;
    }

    .spotlight-section {
      min-height: 175vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      background-color: #0f0f0f;
      position: relative;
      z-index: 10;
    }

    .left-curtain, .right-curtain {
      position: absolute;
      top: 0;
      width: 50vw;
      height: 100%;
      background-image: url('/red_curtain.png');
      background-size: cover;
      background-repeat: no-repeat;
      background-position: center;
      z-index: 1000;
      transition: transform 0.6s ease-out;
      pointer-events: none;
    }

    .left-curtain {
      left: 0;
      transform: translateX(0%);
    }

    .right-curtain {
      right: 0;
      transform: translateX(0%) scaleX(-1);
    }

    .spotlight-inner {
      position: sticky;
      top: 25vh;
      text-align: center;
      z-index: 900;
      transition: top 0.2s ease-out;
    }

    .spotlight-inner h2 {
      font-size: 3rem;
      color: #f0d375;
      margin-bottom: 1rem;
    }

    .spotlight-container {
      max-width: 900px;
      margin: 0 auto;
    }

    .spotlight-container h3 {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    .spotlight-container p {
      font-size: 1.1rem;
      color: #ddd;
    }

    section.project-group {
      padding: 6rem 2rem;
      background-color: #0a0a0a;
      border-top: 1px solid #222;
    }

    section.project-group h2 {
      font-size: 2.8rem;
      color: #d4af37;
      text-align: center;
      margin-bottom: 2rem;
    }

    .project-item {
      max-width: 900px;
      margin: 0 auto 3rem;
      padding: 1rem 2rem;
      border-left: 4px solid #c79c3b;
    }

    .project-item h3 {
      font-size: 1.6rem;
      margin-bottom: 0.5rem;
    }

    .project-item p {
      font-size: 1rem;
      color: #ccc;
    }
  </style>

  <main id="main-content">
    <section class="hero-section">
      <div class="hero-title">Projects</div>
      <div class="hero-description">
        A growing archive of experiments, technologies, and philosophical blueprints — all aiming to imagine (and build) a different kind of future.
      </div>
      <div class="quote">
        "The best way to predict the future is to invent it."<br/><span>– Alan Kay</span>
      </div>
    </section>

    <section class="spotlight-section" id="spotlight">
      <div class="left-curtain" id="leftCurtain"></div>
      <div class="right-curtain" id="rightCurtain"></div>
      <div class="spotlight-inner" id="spotlightInner">
        <h2>🔦 Spotlight</h2>
        <div class="spotlight-container">
          <h3>ASCEND</h3>
          <p>A modular AI architecture integrating planning, memory, and flexible logic. This project is the core of a broader superhero technology suite and personal computing revolution.</p>
        </div>
      </div>
    </section>

    <section class="project-group" id="engineering">
      <h2>⚙️ Engineering</h2>
      <div class="carousel-container" id="carousel">
        <div class="carousel-card"><img src="/Logo.png" alt="ASCEND Logo" class="carousel-logo" /><h3>ASCEND</h3><p class="timeline">2024 – Present</p><p class="description">Set A</p></div>
        <div class="carousel-card"><img src="/Logo.png" alt="Zenith Logo" class="carousel-logo" /><h3>Zenith</h3><p class="timeline">2025 – Present</p><p class="description">Set A</p></div>
        <div class="carousel-card"><img src="/Logo.png" alt="Stratum Logo" class="carousel-logo" /><h3>Stratum</h3><p class="timeline">2024 – Present</p><p class="description">Set A</p></div>

        <div class="carousel-card"><img src="/Logo.png" alt="ASCEND Logo" class="carousel-logo" /><h3>ASCEND</h3><p class="timeline">2024 – Present</p><p class="description">Set B</p></div>
        <div class="carousel-card"><img src="/Logo.png" alt="Zenith Logo" class="carousel-logo" /><h3>Zenith</h3><p class="timeline">2025 – Present</p><p class="description">Set B</p></div>
        <div class="carousel-card"><img src="/Logo.png" alt="Stratum Logo" class="carousel-logo" /><h3>Stratum</h3><p class="timeline">2024 – Present</p><p class="description">Set B</p></div>

        <div class="carousel-card"><img src="/Logo.png" alt="ASCEND Logo" class="carousel-logo" /><h3>ASCEND</h3><p class="timeline">2024 – Present</p><p class="description">Set C</p></div>
        <div class="carousel-card"><img src="/Logo.png" alt="Zenith Logo" class="carousel-logo" /><h3>Zenith</h3><p class="timeline">2025 – Present</p><p class="description">Set C</p></div>
        <div class="carousel-card"><img src="/Logo.png" alt="Stratum Logo" class="carousel-logo" /><h3>Stratum</h3><p class="timeline">2024 – Present</p><p class="description">Set C</p></div>
      </div>
      <div class="carousel-dots" id="carouselDots"></div>
    </section>

    <style>
      .carousel-container {
        width: 95vw;
        overflow-x: scroll;
        scroll-snap-type: x mandatory;
        display: flex;
        gap: 4vw;
        padding: 0 2vw;
        scroll-behavior: smooth;
      }

      .carousel-card {
        flex: 0 0 75vw;
        scroll-snap-align: center;
        border-radius: 20px;
        height: 550px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
        box-shadow: 0 0 30px rgba(0, 120, 255, 0.2);
        background: linear-gradient(135deg, #202e78, #8c52ff);
      }

      .carousel-card:nth-child(3n+1) { background: linear-gradient(135deg, #1a4d2e, #4cb944); }
      .carousel-card:nth-child(3n+2) { background: linear-gradient(135deg, #532e1c, #c07f00); }
      .carousel-card:nth-child(3n+3) { background: linear-gradient(135deg, #35013f, #b3005e); }

      .carousel-card:hover {
        box-shadow: 0 0 40px rgba(0, 120, 255, 0.6);
        transform: scale(1.02);
      }

      .carousel-card h3 {
        font-size: 2.5rem;
        margin: 0;
        color: #fff;
      }

      .carousel-logo {
        height: 130px;
        margin-bottom: 1rem;
        object-fit: contain;
      }

      .timeline {
        font-style: italic;
        color: #eee;
        margin: 0.5rem 0 1rem;
      }

      .description {
        color: #fdfdfd;
        text-align: center;
        max-width: 90%;
        font-size: 1.2rem;
      }

      .carousel-container::-webkit-scrollbar { display: none; }
      .carousel-container { -ms-overflow-style: none; scrollbar-width: none; }

      .carousel-dots {
        text-align: center;
        margin-top: 1rem;
      }

      .carousel-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        margin: 0 5px;
        background-color: #888;
        border-radius: 50%;
        cursor: pointer;
      }

      .carousel-dot.active {
        background-color: #f0d375;
      }
    </style>

    <script>
      const carousel = document.getElementById("carousel");
      const dotsContainer = document.getElementById("carouselDots");
      const cards = carousel.querySelectorAll(".carousel-card");
      const totalVisible = cards.length / 3;
      const cardWidth = () => cards[0].offsetWidth + parseInt(getComputedStyle(carousel).gap || 0);

      let current = totalVisible;

      function goToIndex(index, instant = false) {
        const centerOffset = (window.innerWidth - cardWidth()) / 2;
        carousel.scrollTo({ left: cardWidth() * index - centerOffset, behavior: instant ? "auto" : "smooth" });
        current = index;
        updateDots();
      }

      function updateDots() {
        document.querySelectorAll('.carousel-dot').forEach((dot, i) => {
          dot.classList.toggle('active', i === ((current - totalVisible + totalVisible) % totalVisible));
        });
      }

      window.addEventListener("load", () => goToIndex(totalVisible, true));

      carousel.addEventListener("scroll", () => {
        const scrollLeft = carousel.scrollLeft;
        const i = Math.round((scrollLeft + (cardWidth() - carousel.offsetWidth) / 2) / cardWidth());

        if (i < totalVisible) goToIndex(i + totalVisible, true);
        else if (i >= totalVisible * 2) goToIndex(i - totalVisible, true);
        else current = i;

        updateDots();
      });

      carousel.addEventListener("click", (e) => {
        const center = carousel.scrollLeft + carousel.offsetWidth / 2;
        let closest = { i: -1, d: Infinity };

        cards.forEach((card, i) => {
          const mid = card.offsetLeft + card.offsetWidth / 2;
          const dist = Math.abs(center - mid);
          if (dist < closest.d) closest = { i, d: dist };
        });

        const target = e.target.closest(".carousel-card");
        if (!target) return;
        const clickedIndex = Array.from(cards).indexOf(target);
        if (clickedIndex < closest.i) goToIndex(current - 1);
        else if (clickedIndex > closest.i) goToIndex(current + 1);
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") goToIndex(current + 1);
        else if (e.key === "ArrowLeft") goToIndex(current - 1);
      });

      for (let i = 0; i < totalVisible; i++) {
        const dot = document.createElement('div');
        dot.classList.add('carousel-dot');
        dot.addEventListener('click', () => goToIndex(i + totalVisible));
        dotsContainer.appendChild(dot);
      }
      updateDots();
    </script>

    <section class="project-group" id="chemistry">
      <h2>🧪 Chemistry</h2>
      <div class="project-item">
        <h3>Hydride Transfer Study</h3>
        <p>Mechanistic investigations on metal-catalyzed reduction of N-heterocycles using kinetic isotope effects and redox ligand tuning.</p>
      </div>
    </section>

    <section class="project-group" id="philosophy">
      <h2>🧠 Philosophy</h2>
      <div class="project-item">
        <h3>The Nature of Sin</h3>
        <p>A multi-religious inquiry into morality, punishment, and the fluid boundaries of human nature across civilizations.</p>
      </div>
    </section>

    <section class="project-group" id="writing">
      <h2>✍️ Writing</h2>
      <div class="project-item">
        <h3>Book of Love</h3>
        <p>A modern philosophical treatise on romantic and human love, inspired by Plato, Dostoevsky, and the scriptures.</p>
      </div>
    </section>

    <section class="project-group" id="personal-projects">
      <h2>🌱 Personal Projects</h2>
      <div class="project-item">
        <h3>GenSim</h3>
        <p>Simulating life from a single gene to human-like development, exploring how far DNA alone can govern complexity.</p>
      </div>
    </section>

    <section class="project-group" id="legacy">
      <h2>🪐 Legacy & Vision</h2>
      <div class="project-item">
        <h3>Primis</h3>
        <p>Designing the world’s most intellectually and ethically advanced global school system, rooted in tiered opportunity and holistic education.</p>
      </div>
    </section>

    <script>
      window.addEventListener('scroll', () => {
        const spotlight = document.getElementById('spotlight');
        const inner = document.getElementById('spotlightInner');
        const left = document.getElementById('leftCurtain');
        const right = document.getElementById('rightCurtain');

        const spotlightTop = spotlight.offsetTop;
        const scrollY = window.scrollY;
        const distance = scrollY - spotlightTop + window.innerHeight / 2;

        if (distance > 0) {
          const curtainShift = Math.min(distance / 2, window.innerWidth / 2);
          left.style.transform = `translateX(-${curtainShift}px)`;
          right.style.transform = `translateX(${curtainShift}px) scaleX(-1)`;
        }

        const newTop = Math.min(25 + distance / 32, 35);
        inner.style.top = `${newTop}vh`;
      });
    </script>
  </main>
</BaseLayout>
