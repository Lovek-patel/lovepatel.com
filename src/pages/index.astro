---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeaturedSplit from '../components/home/FeaturedSplit.astro';
import Hero from '../components/home/Hero.astro';
import ContactIconBar from '../components/home/ContactIconBar.astro';
import ProjectsCarousel from '../components/home/ProjectsCarousel.astro';
import WritingFeed from '../components/home/WritingFeed.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const resolveProjectSlug = (entry) => entry.slug ?? entry.id.replace(/\.json$/, '');
const sortedProjects = [...projects].sort((a, b) =>
  resolveProjectSlug(a).localeCompare(resolveProjectSlug(b))
);
const featuredProjectEntry =
  projects.find((entry) => entry.data.featured) ?? sortedProjects[sortedProjects.length - 1];
const featuredProject = {
  ...featuredProjectEntry.data,
  slug: resolveProjectSlug(featuredProjectEntry)
};
const featuredProjects = sortedProjects.map((entry) => ({
  ...entry.data,
  slug: resolveProjectSlug(entry)
}));
const updates = await getCollection('updates');
const sortedUpdates = [...updates].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestUpdateEntry = sortedUpdates[0];
const latestUpdate = {
  ...latestUpdateEntry.data,
  slug: latestUpdateEntry.slug
};

const heroContent = {
  pill: 'Ad Astra',
  headline: 'Designing systems that make the impossible feel inevitable.',
  summary:
    'Welcome to my personal constellation — a curated space for experiments, life updates, and the projects shaping my future.',
  actions: [
    {
      href: '/projects',
      label: 'Explore Projects',
      className:
        'rounded-full border border-white/10 bg-aurora px-6 py-3 text-sm font-semibold text-cosmic-900'
    },
    {
      href: '/updates',
      label: 'Read Life Updates',
      className:
        'rounded-full border border-white/10 px-6 py-3 text-sm font-semibold text-starlight/80'
    }
  ],
  image: {
    src: '/portrait-placeholder.svg',
    alt: 'Portrait placeholder'
  }
};

const featuredProjectsSection = {
  heading: 'Featured Projects',
  linkHref: '/projects',
  linkLabel: 'View all →'
};

const latestUpdatesCarousel = sortedUpdates.slice(0, 4).map((entry) => ({
  label: 'Life Update',
  title: entry.data.title,
  description: entry.data.description,
  href: `/updates/${entry.slug}`,
  linkLabel: 'Read update →'
}));

const writingFeedSection = {
  heading: 'Latest Updates',
  description: 'Use arrows or swipe to navigate.'
};

const contactLinks = [
  {
    href: 'mailto:lkp2133@columbia.edu',
    label: 'Email',
    icon: '/email.png'
  },
  {
    href: 'https://www.linkedin.com',
    label: 'LinkedIn',
    icon: '/linkedin.png'
  },
  {
    href: 'https://www.instagram.com',
    label: 'Instagram',
    icon: '/instagram.png'
  },
  {
    href: 'https://www.snapchat.com',
    label: 'Snapchat',
    icon: '/snapchat.png'
  }
];

const contactSection = {
  heading: 'Contact'
};
---
<BaseLayout title="Home" description="Love Patel — space-inspired personal website, projects, and life updates.">
  <Header slot="header" />
  <section class="mx-auto flex max-w-6xl flex-col gap-12 px-6 py-16">
    <Hero {...heroContent} />

    <FeaturedSplit project={featuredProject} update={latestUpdate} />

    <ProjectsCarousel {...featuredProjectsSection} projects={featuredProjects} />

    <WritingFeed {...writingFeedSection} items={latestUpdatesCarousel} />
  </section>
  <section class="px-6 pb-16">
    <ContactIconBar {...contactSection} links={contactLinks} />
  </section>
  <Footer slot="footer" />
</BaseLayout>
