---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeaturedSplit from '../components/home/FeaturedSplit.astro';
import Hero from '../components/home/Hero.astro';
import ProjectsCarousel from '../components/home/ProjectsCarousel.astro';
import WritingFeed from '../components/home/WritingFeed.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featuredProjects = projects.slice(0, 4).map((entry) => ({
  ...entry.data,
  slug: entry.slug
}));

const heroContent = {
  pill: 'Ad Astra',
  title: 'Designing systems that make the impossible feel inevitable.',
  summary:
    'Welcome to my personal constellation — a curated space for experiments, life updates, and the projects shaping my future.',
  actions: [
    {
      href: '/projects',
      label: 'Explore Projects',
      className:
        'rounded-full border border-white/10 bg-aurora px-6 py-3 text-sm font-semibold text-cosmic-900'
    },
    {
      href: '/updates',
      label: 'Read Life Updates',
      className:
        'rounded-full border border-white/10 px-6 py-3 text-sm font-semibold text-starlight/80'
    }
  ]
};

const latestUpdate = {
  label: 'Latest Update',
  title: 'Quiet Progress, Real Momentum',
  description: "Shipping isn't always loud. Here's what quietly moved forward this month.",
  href: '/updates/2025-03-30-quiet-progress',
  linkText: 'Read more →'
};

const featuredProjectsSection = {
  heading: 'Featured Projects',
  linkHref: '/projects',
  linkLabel: 'View all →'
};

const carouselItems = [
  {
    label: 'Featured Update',
    title: 'Ad Astra: A North Star for 2025',
    description: 'Setting an intentional direction for the year with focus on craft, research, and impact.'
  },
  {
    label: 'Featured Project',
    title: 'ASCEND',
    description: 'A modular AI architecture for decision-making, memory, and long-horizon planning.'
  },
  {
    label: 'Featured Project',
    title: 'Primis',
    description: 'A vision for a global education system rooted in ethics and curiosity.'
  }
];

const writingFeedSection = {
  heading: 'Featured Feed',
  description: 'Use arrows or swipe to navigate.'
};
---
<BaseLayout title="Home" description="Love Patel — space-inspired personal website, projects, and life updates.">
  <Header slot="header" />
  <section class="mx-auto flex max-w-6xl flex-col gap-12 px-6 py-16">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr]">
      <Hero {...heroContent} />
      <FeaturedSplit {...latestUpdate} />
    </div>

    <ProjectsCarousel {...featuredProjectsSection} projects={featuredProjects} />

    <WritingFeed {...writingFeedSection} items={carouselItems} />
  </section>
  <Footer slot="footer" />
</BaseLayout>
