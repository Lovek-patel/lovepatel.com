---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Love Patel"
  description="Love Patel's personal website featuring projects, life updates, and professional highlights."
>
  <style>
    section {
      padding: 6rem 2rem 4rem;
      text-align: center;
    }

    .hero {
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding-top: 2rem;
    }

    .hero-icon {
      font-size: 4rem;
      margin-bottom: 1.5rem;
    }

    .tagline {
      font-size: 1.75rem;
      font-style: italic;
      color: var(--color-accent);
      max-width: 600px;
      margin-bottom: 2rem;
    }

    .section-heading {
      font-family: 'Playfair Display', serif;
      color: var(--color-accent);
      font-size: 2rem;
      margin-bottom: 1.5rem;
      text-decoration: none;
    }

    .preview-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 2.5rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .card {
      background: linear-gradient(145deg, #1c1c1c, #131313);
      border-radius: 16px;
      padding: 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      box-shadow: 0 4px 20px rgba(0,0,0,0.4);
      transition: all 0.3s ease;
    }

    .card:hover {
      transform: scale(1.04);
      box-shadow: 0 6px 30px rgba(199, 156, 59, 0.3);
    }

    .emoji {
      font-size: 2.8rem;
      margin-bottom: 1rem;
    }

    .title {
      font-size: 1.2rem;
      font-weight: 600;
      color: #f5f5f5;
      text-decoration: none;
    }

    .fake-box {
      border: 1px dashed #444;
      padding: 2rem;
      border-radius: 12px;
      color: #999;
      font-style: italic;
      background-color: #141414;
    }

    footer {
      text-align: center;
      font-size: 0.9rem;
      color: #777;
      padding: 2rem;
    }
  </style>

  <main id="main-content">
    <section class="hero">
      <div class="hero-icon">🌠</div>
      <div class="tagline">I hope to make the impossible feel inevitable.</div>
    </section>

    <section>
      <a href="/about" class="section-heading">What I Stand For</a>
      <p style="max-width: 800px; margin: 0 auto;">A place for your mission, purpose, and why this site exists. Later you’ll describe your values and what you’re building toward.</p>
    </section>

    <section>
      <a href="/about" class="section-heading">What I'm Doing</a>
      <p style="max-width: 800px; margin: 0 auto;">Current roles, education, and professional direction. This can outline your position, research, or active projects.</p>
    </section>

    <section>
      <a href="/projects" class="section-heading">Projects</a>
      <div class="preview-grid">
        <div class="card"><div class="emoji">🌿</div><div class="title">Project 1</div></div>
        <div class="card"><div class="emoji">🔮</div><div class="title">Project 2</div></div>
        <div class="card"><div class="emoji">🧬</div><div class="title">Project 3</div></div>
      </div>
    </section>

    <section>
      <a href="/blog" class="section-heading">Blog</a>
      <div class="preview-grid">
        <div class="card"><div class="emoji">📝</div><div class="title">Article 1</div></div>
        <div class="card"><div class="emoji">🗣️</div><div class="title">Article 2</div></div>
      </div>
    </section>

    <section>
      <a href="/updates" class="section-heading">Updates</a>
      <div class="fake-box">Sign up or log in to see private updates. (Feature coming soon)</div>
    </section>

    <footer>
      &copy; 2025 Love Patel. All rights reserved.
    </footer>
  </main>
</BaseLayout>
