---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Gallery | Love Patel"
  description="A curated collection of moments, visuals, and memories."
>
  <style>
    :global(body) {
      background-color: #0e0e0e;
    }

    h1 {
      text-align: center;
      font-size: 2.2rem;
      color: #c79c3b;
      margin-bottom: 0.5rem;
    }

    .gallery-intro {
      text-align: center;
      color: #ccc;
      margin-bottom: 2rem;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
      max-width: 1100px;
      margin: 0 auto 4rem;
      padding: 0 1rem;
    }

    .gallery-grid img {
      width: 100%;
      height: auto;
      border-radius: 10px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      box-shadow: 0 0 8px rgba(0, 0, 0, 0.4);
    }

    .gallery-grid img:hover {
      transform: scale(1.03);
      box-shadow: 0 0 15px rgba(199, 156, 59, 0.4);
    }
  </style>

  <main id="main-content">
    <h1>📸 Gallery</h1>
    <p class="gallery-intro">A curated collection of moments, visuals, and memories.</p>

    <div class="gallery-grid">
      <img src="/gallery1.jpg" alt="Gallery 1">
      <img src="/gallery2.jpg" alt="Gallery 2">
      <img src="/gallery3.jpg" alt="Gallery 3">
      <img src="/gallery4.jpg" alt="Gallery 4">
      <img src="/gallery5.jpg" alt="Gallery 5">
      <img src="/gallery6.jpg" alt="Gallery 6">
    </div>
  </main>
</BaseLayout>
